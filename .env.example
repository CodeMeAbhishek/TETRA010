# TETRA010 — Environment Configuration
# Copy this file to .env and fill in your chosen provider key.
# The .env file must NOT be committed to version control.

# ── Provider selection ──────────────────────────────────────────────────────
# Set to "nvidia" (default) or "openrouter"
LLM_PROVIDER=nvidia

# ── NVIDIA NIM (recommended — Llama 3.3 70B, free credits on signup) ───────
# Get your key: https://build.nvidia.com → Sign in → Get API Key
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenRouter (alternative — free tier, no card needed) ───────────────────
# Get your key: https://openrouter.ai/keys
# Free model used: meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
